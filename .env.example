# Server-side only — never expose to the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron authorization — set a random secret in Production before deploying.
CRON_SECRET=

# Client-safe — exposed to the browser bundle via the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
